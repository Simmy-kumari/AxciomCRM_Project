@model AcxiomCRM.ViewModels.ActivityListViewModel
@{
    ViewData["Title"] = "CRM Activity Timeline";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h2 class="fw-bold text-dark mb-1 tracking-tight">Activities & Engagement History</h2>
        <p class="text-muted small mb-0">Chronological interactions log: Calls, Meetings, Emails, and Tasks.</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <a asp-action="Create" class="btn btn-primary-crm shadow-sm">
            <i class="bi bi-clock-history"></i>
            <span>Log Activity</span>
        </a>
    </div>
</div>

<!-- Type Summary Metric Badges -->
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-md-3">
        <a asp-action="Index" asp-route-typeFilter="Call" class="text-decoration-none">
            <div class="card border-0 shadow-sm p-3 bg-white" style="border-radius: var(--crm-radius);">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small fw-bold text-uppercase">Phone Calls</div>
                        <div class="fs-4 fw-bold text-dark">@Model.CallsCount</div>
                    </div>
                    <div class="p-2 rounded bg-primary-subtle text-primary fs-3"><i class="bi bi-telephone"></i></div>
                </div>
            </div>
        </a>
    </div>
    <div class="col-sm-6 col-md-3">
        <a asp-action="Index" asp-route-typeFilter="Meeting" class="text-decoration-none">
            <div class="card border-0 shadow-sm p-3 bg-white" style="border-radius: var(--crm-radius);">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small fw-bold text-uppercase">Meetings</div>
                        <div class="fs-4 fw-bold text-purple">@Model.MeetingsCount</div>
                    </div>
                    <div class="p-2 rounded bg-purple-subtle text-purple fs-3"><i class="bi bi-people"></i></div>
                </div>
            </div>
        </a>
    </div>
    <div class="col-sm-6 col-md-3">
        <a asp-action="Index" asp-route-typeFilter="Email" class="text-decoration-none">
            <div class="card border-0 shadow-sm p-3 bg-white" style="border-radius: var(--crm-radius);">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small fw-bold text-uppercase">Emails Sent</div>
                        <div class="fs-4 fw-bold text-warning">@Model.EmailsCount</div>
                    </div>
                    <div class="p-2 rounded bg-warning-subtle text-warning fs-3"><i class="bi bi-envelope"></i></div>
                </div>
            </div>
        </a>
    </div>
    <div class="col-sm-6 col-md-3">
        <a asp-action="Index" asp-route-typeFilter="Task" class="text-decoration-none">
            <div class="card border-0 shadow-sm p-3 bg-white" style="border-radius: var(--crm-radius);">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <div class="text-muted small fw-bold text-uppercase">Assigned Tasks</div>
                        <div class="fs-4 fw-bold text-success">@Model.TasksCount</div>
                    </div>
                    <div class="p-2 rounded bg-success-subtle text-success fs-3"><i class="bi bi-check2-square"></i></div>
                </div>
            </div>
        </a>
    </div>
</div>

<!-- Search & Type Filter Bar -->
<div class="crm-card mb-4">
    <div class="p-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-center">
            <div class="col-md-6">
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-search"></i></span>
                    <input type="text" name="searchTerm" value="@Model.SearchTerm" class="form-control border-start-0 shadow-none" 
                           placeholder="Search activity subject, minutes or description..." />
                </div>
            </div>
            <div class="col-md-3">
                <select name="typeFilter" class="form-select shadow-none">
                    <option value="">All Activity Types</option>
                    <option value="Call" selected="@(Model.TypeFilter == "Call")">Calls</option>
                    <option value="Meeting" selected="@(Model.TypeFilter == "Meeting")">Meetings</option>
                    <option value="Email" selected="@(Model.TypeFilter == "Email")">Emails</option>
                    <option value="Task" selected="@(Model.TypeFilter == "Task")">Tasks</option>
                </select>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary-crm w-100 justify-content-center">Filter</button>
                <a asp-action="Index" class="btn btn-secondary-crm">Clear</a>
            </div>
        </form>
    </div>

    <!-- Timeline Body -->
    <div class="p-4">
        @if (Model.Activities.Any())
        {
            <div class="activity-timeline">
                @foreach (var act in Model.Activities)
                {
                    <div class="timeline-item">
                        <div class="timeline-badge @(act.ActivityType == "Meeting" ? "timeline-badge-meeting" : act.ActivityType == "Call" ? "timeline-badge-call" : act.ActivityType == "Email" ? "timeline-badge-email" : "timeline-badge-task")">
                            <i class="bi @(act.ActivityType == "Meeting" ? "bi-people" : act.ActivityType == "Call" ? "bi-telephone" : act.ActivityType == "Email" ? "bi-envelope" : "bi-check2-square")"></i>
                        </div>
                        <div class="timeline-content-card">
                            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-1 mb-2">
                                <div class="d-flex align-items-center gap-2">
                                    <h6 class="fw-bold text-dark mb-0">@act.Subject</h6>
                                    <span class="badge bg-light text-secondary border">@act.ActivityType</span>
                                    <span class="badge-crm @(act.Status == "Completed" ? "badge-won" : "badge-new")">@act.Status</span>
                                </div>
                                <div class="small text-muted">
                                    <i class="bi bi-clock me-1"></i>@act.ActivityDate.ToString("MMM dd, yyyy - hh:mm tt")
                                </div>
                            </div>

                            @if (!string.IsNullOrEmpty(act.Description))
                            {
                                <p class="text-secondary small mb-2">@act.Description</p>
                            }

                            <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                                <div class="small text-muted">
                                    @if (!string.IsNullOrEmpty(act.RelatedName))
                                    {
                                        <span>Related @act.RelatedType: <strong class="text-dark">@act.RelatedName</strong> &bull; </span>
                                    }
                                    <span>Assigned: <strong>@act.AssignedToName</strong></span>
                                </div>

                                <div class="btn-group">
                                    <form asp-action="ToggleStatus" asp-route-id="@act.ActivityId" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-link text-decoration-none small p-0 me-2" title="Toggle Status">
                                            <i class="bi @(act.Status == "Completed" ? "bi-arrow-counterclockwise" : "bi-check-circle")"></i>
                                            @(act.Status == "Completed" ? "Mark Pending" : "Mark Completed")
                                        </button>
                                    </form>

                                    <button type="button" class="btn btn-sm btn-link text-danger text-decoration-none small p-0"
                                            data-bs-toggle="modal" data-bs-target="#deleteConfirmModal"
                                            data-action="@Url.Action("Delete", "Activities", new { id = act.ActivityId })"
                                            data-name="@act.Subject" data-type="Activity Log">
                                        <i class="bi bi-trash3"></i> Delete
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-clock-history fs-1 d-block mb-2 text-secondary"></i>
                <h5>No Activities Logged</h5>
                <p class="small text-muted mb-3">No activity records match your current criteria.</p>
                <a asp-action="Create" class="btn btn-sm btn-primary-crm">Log First Activity</a>
            </div>
        }
    </div>
</div>
