@model AcxiomCRM.ViewModels.ActivityFormViewModel
@{
    ViewData["Title"] = "Log CRM Activity";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="d-flex align-items-center justify-content-between mb-4">
            <div>
                <a asp-action="Index" class="text-decoration-none text-muted small d-inline-flex align-items-center gap-1 mb-1">
                    <i class="bi bi-arrow-left"></i> Back to Activities
                </a>
                <h2 class="fw-bold text-dark mb-0">Log CRM Activity</h2>
            </div>
        </div>

        <div class="crm-card">
            <div class="crm-card-header">
                <div>
                    <h5 class="crm-card-title">Activity Information</h5>
                    <small class="text-muted">Record phone discussion, executive meeting notes, email exchanges, or internal tasks</small>
                </div>
            </div>

            <div class="crm-card-body">
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger py-2 px-3 small border-0 mb-4" style="background-color: #fef2f2; color: #991b1b; border-radius: 8px;">
                        <div asp-validation-summary="All" class="mb-0"></div>
                    </div>
                }

                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()

                    <div class="row g-3">
                        <!-- Type -->
                        <div class="col-md-6">
                            <label asp-for="ActivityType" class="form-label-crm"></label>
                            <select asp-for="ActivityType" class="form-select form-select-crm">
                                <option value="Call">Phone Call</option>
                                <option value="Meeting">Executive Meeting</option>
                                <option value="Email">Email Exchange</option>
                                <option value="Task">Assigned Task</option>
                            </select>
                            <span asp-validation-for="ActivityType" class="text-danger small"></span>
                        </div>

                        <!-- Date -->
                        <div class="col-md-6">
                            <label asp-for="ActivityDate" class="form-label-crm"></label>
                            <input asp-for="ActivityDate" class="form-control form-control-crm" type="datetime-local" />
                            <span asp-validation-for="ActivityDate" class="text-danger small"></span>
                        </div>

                        <!-- Subject -->
                        <div class="col-12">
                            <label asp-for="Subject" class="form-label-crm"></label>
                            <input asp-for="Subject" class="form-control form-control-crm" placeholder="e.g. Discussed cloud migration architecture and pricing" />
                            <span asp-validation-for="Subject" class="text-danger small"></span>
                        </div>

                        <!-- Customer link -->
                        <div class="col-md-6">
                            <label asp-for="CustomerId" class="form-label-crm"></label>
                            <select asp-for="CustomerId" class="form-select form-select-crm" asp-items="ViewBag.CustomersList">
                                <option value="">Select Associated Customer (Optional)...</option>
                            </select>
                        </div>

                        <!-- Lead link -->
                        <div class="col-md-6">
                            <label asp-for="LeadId" class="form-label-crm"></label>
                            <select asp-for="LeadId" class="form-select form-select-crm" asp-items="ViewBag.LeadsList">
                                <option value="">Select Associated Lead (Optional)...</option>
                            </select>
                        </div>

                        <!-- Assigned User -->
                        <div class="col-md-6">
                            <label asp-for="AssignedTo" class="form-label-crm"></label>
                            <select asp-for="AssignedTo" class="form-select form-select-crm" asp-items="ViewBag.UsersList">
                                <option value="">Select User...</option>
                            </select>
                        </div>

                        <!-- Status -->
                        <div class="col-md-6">
                            <label asp-for="Status" class="form-label-crm"></label>
                            <select asp-for="Status" class="form-select form-select-crm">
                                <option value="Completed">Completed</option>
                                <option value="Pending">Pending</option>
                            </select>
                        </div>

                        <!-- Description -->
                        <div class="col-12">
                            <label asp-for="Description" class="form-label-crm"></label>
                            <textarea asp-for="Description" class="form-control form-control-crm" rows="4" placeholder="Detailed notes, minutes of the meeting, customer questions, next action items..."></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mt-4 pt-3 border-top d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-secondary-crm">Cancel</a>
                        <button type="submit" class="btn btn-primary-crm">
                            <i class="bi bi-check2-circle"></i> Log Activity
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
