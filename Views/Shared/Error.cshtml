@model ErrorViewModel
@{
    ViewData["Title"] = "System Notification";
}

<div class="row justify-content-center py-5">
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm p-4 p-md-5 text-center bg-white" style="border-radius: var(--crm-radius-lg);">
            <div class="d-inline-flex align-items-center justify-content-center p-3 rounded-circle bg-danger-subtle text-danger mx-auto mb-3" style="width: 64px; height: 64px;">
                <i class="bi bi-exclamation-triangle-fill fs-2"></i>
            </div>

            <h3 class="fw-bold text-dark mb-2">An Unexpected Issue Occurred</h3>
            <p class="text-muted small mb-4">
                The application encountered an unhandled situation while processing this request. Our system security monitors have logged this event.
            </p>

            @if (Model.ShowRequestId)
            {
                <div class="bg-light p-3 rounded-3 mb-4 text-start font-monospace small border">
                    <span class="text-muted">Tracking Reference ID:</span>
                    <strong class="text-dark d-block">@Model.RequestId</strong>
                </div>
            }

            <div class="d-flex justify-content-center gap-2">
                <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary-crm px-4">
                    <i class="bi bi-arrow-left"></i> Return to Dashboard
                </a>
                <button type="button" class="btn btn-secondary-crm" onclick="window.history.back();">
                    Go Back
                </button>
            </div>
        </div>
    </div>
</div>

