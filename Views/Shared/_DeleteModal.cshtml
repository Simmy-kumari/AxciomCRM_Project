<!-- Reusable Confirmation Dialog for Destructive Actions -->
<div class="modal fade" id="deleteConfirmModal" tabindex="-1" aria-labelledby="deleteModalTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg" style="border-radius: var(--crm-radius-lg);">
            <div class="modal-header border-0 pb-0 pt-4 px-4">
                <div class="d-flex align-items-center gap-3">
                    <div style="width: 44px; height: 44px; border-radius: 50%; background-color: #fee2e2; color: #dc2626; display: flex; align-items: center; justify-content: center; font-size: 1.25rem;">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                    </div>
                    <div>
                        <h5 class="modal-title fw-bold text-dark mb-0" id="deleteModalTitle">Confirm Action</h5>
                        <p class="text-muted small mb-0">This operation cannot be undone.</p>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body px-4 py-3">
                <p class="text-secondary mb-0">
                    Are you sure you want to remove <strong id="deleteItemName" class="text-dark">this record</strong>?
                    All associated CRM history and links will be permanently unlinked.
                </p>
            </div>
            <div class="modal-footer border-0 pt-0 pb-4 px-4">
                <button type="button" class="btn btn-light px-3 fw-semibold" data-bs-dismiss="modal">Cancel</button>
                <form id="deleteConfirmForm" method="post" action="">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger px-4 fw-semibold d-inline-flex align-items-center gap-2">
                        <i class="bi bi-trash3-fill"></i>
                        <span>Confirm Delete</span>
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
