@{
    ViewData["Title"] = "Access Restricted";
    Layout = "_Layout";
}

<div class="py-5 text-center">
    <div class="card border-0 shadow-sm mx-auto p-5" style="max-width: 520px; border-radius: 16px;">
        <div class="mb-4">
            <div class="d-inline-flex p-3 rounded-circle bg-danger-subtle text-danger mb-3">
                <i class="bi bi-shield-x fs-1"></i>
            </div>
            <h3 class="fw-bold text-dark">Access Restricted</h3>
            <p class="text-muted small">You do not possess the required permission level or role privileges to view or manage this CRM resource.</p>
        </div>

        <div class="alert alert-warning text-start small border-0 bg-warning-subtle text-warning-emphasis p-3 mb-4 rounded-3">
            <div class="fw-bold mb-1"><i class="bi bi-info-circle-fill me-1"></i> Role-Based Access Enforcement</div>
            Certain administrative operations such as <strong>User Administration</strong> and <strong>System Audit Logs</strong> are restricted to Administrator and Management scopes.
        </div>

        <div class="d-flex justify-content-center gap-2">
            <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary px-4 fw-semibold">
                <i class="bi bi-arrow-left me-1"></i> Back to Dashboard
            </a>
            <a asp-controller="Account" asp-action="Login" class="btn btn-outline-secondary px-3">
                Switch User
            </a>
        </div>
    </div>
</div>
