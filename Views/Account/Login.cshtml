@model AcxiomCRM.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Sign In — AcxiomCRM";
    Layout = "_Layout";
}

<div class="min-vh-100 d-flex flex-column justify-content-center align-items-center py-5" 
     style="background: radial-gradient(circle at 10% 20%, #0f172a 0%, #1e293b 90%);">
    <div class="container" style="max-width: 480px;">
        
        <!-- Brand Header -->
        <div class="text-center mb-4">
            <div class="d-inline-flex align-items-center justify-content-center p-3 mb-3 rounded-4 shadow-lg"
                 style="background: linear-gradient(135deg, #3b82f6 0%, #4f46e5 100%); width: 64px; height: 64px;">
                <i class="bi bi-clouds-fill text-white fs-2"></i>
            </div>
            <h2 class="fw-bold text-white mb-1 tracking-tight">Acxiom<span style="color: #60a5fa;">CRM</span></h2>
            <p class="text-light text-opacity-75 small">Customer Relationship & Sales Pipeline Intelligence</p>
        </div>

        <!-- Login Card -->
        <div class="card border-0 shadow-lg p-4 p-sm-5" style="border-radius: 18px; background-color: #ffffff;">
            
            <div class="mb-4">
                <h4 class="fw-bold text-dark mb-1">Welcome back</h4>
                <p class="text-muted small mb-0">Sign in with your enterprise credentials to access your workspace.</p>
            </div>

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger py-2 px-3 small border-0 mb-4" style="background-color: #fef2f2; color: #991b1b; border-radius: 8px;">
                    <div asp-validation-summary="All" class="mb-0"></div>
                </div>
            }

            <form asp-controller="Account" asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
                @Html.AntiForgeryToken()

                <!-- Email -->
                <div class="mb-3">
                    <label asp-for="Email" class="form-label fw-semibold text-secondary small">Corporate Email</label>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-envelope"></i></span>
                        <input asp-for="Email" class="form-control border-start-0 py-2" placeholder="name@acxiom.com" autocomplete="email" />
                    </div>
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <!-- Password -->
                <div class="mb-3">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <label asp-for="Password" class="form-label fw-semibold text-secondary small mb-0">Password</label>
                    </div>
                    <div class="input-group">
                        <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-lock"></i></span>
                        <input asp-for="Password" type="password" id="loginPasswordInput" class="form-control border-start-0 border-end-0 py-2" placeholder="Enter your password" autocomplete="current-password" />
                        <button type="button" class="btn btn-outline-secondary border-start-0 toggle-password bg-light" data-target="loginPasswordInput" title="Show/Hide Password">
                            <i class="bi bi-eye"></i>
                        </button>
                    </div>
                    <span asp-validation-for="Password" class="text-danger small"></span>
                </div>

                <!-- Remember Me & Forgot -->
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div class="form-check">
                        <input asp-for="RememberMe" class="form-check-input" />
                        <label asp-for="RememberMe" class="form-check-label text-muted small">Remember this device</label>
                    </div>
                    <span class="text-muted small">Policy: Min 8 chars</span>
                </div>

                <!-- Submit Button -->
                <button type="submit" class="btn btn-primary w-100 py-2 fw-semibold d-flex align-items-center justify-content-center gap-2 shadow-sm"
                        style="background: linear-gradient(135deg, #3b82f6 0%, #1d4ed8 100%); border: none; border-radius: 8px;">
                    <i class="bi bi-box-arrow-in-right"></i>
                    <span>Sign In to AcxiomCRM</span>
                </button>
            </form>

            <div class="mt-4 pt-3 border-top text-center">
                <span class="text-muted small">New team member?</span>
                <a asp-action="Register" class="text-decoration-none fw-semibold text-primary small ms-1">Create an account</a>
            </div>
        </div>

        <!-- College Demo Quick-Test Panel -->
        <div class="card border-0 shadow mt-4 p-3 text-white" style="border-radius: 14px; background: rgba(255, 255, 255, 0.08); backdrop-filter: blur(10px);">
            <div class="d-flex align-items-center justify-content-between mb-2">
                <span class="fw-bold small text-light text-uppercase tracking-wider" style="font-size: 0.72rem;">
                    <i class="bi bi-lightning-charge-fill text-warning me-1"></i> Quick Demo Role Access (1-Click)
                </span>
                <span class="badge bg-primary bg-opacity-50 text-white" style="font-size: 0.65rem;">Testing Mode</span>
            </div>
            <div class="row g-2">
                <div class="col-4">
                    <form asp-controller="Account" asp-action="QuickDemoLogin" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="role" value="Admin" />
                        <button type="submit" class="btn btn-sm btn-dark w-100 text-truncate text-start p-2 border border-secondary border-opacity-25" style="border-radius: 8px; font-size: 0.75rem;">
                            <div class="fw-bold text-white"><i class="bi bi-shield-lock text-primary me-1"></i> Admin</div>
                            <div class="text-white-50" style="font-size: 0.68rem;">Full Control</div>
                        </button>
                    </form>
                </div>
                <div class="col-4">
                    <form asp-controller="Account" asp-action="QuickDemoLogin" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="role" value="Manager" />
                        <button type="submit" class="btn btn-sm btn-dark w-100 text-truncate text-start p-2 border border-secondary border-opacity-25" style="border-radius: 8px; font-size: 0.75rem;">
                            <div class="fw-bold text-white"><i class="bi bi-pie-chart text-success me-1"></i> Manager</div>
                            <div class="text-white-50" style="font-size: 0.68rem;">Team Pipeline</div>
                        </button>
                    </form>
                </div>
                <div class="col-4">
                    <form asp-controller="Account" asp-action="QuickDemoLogin" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="role" value="SalesExecutive" />
                        <button type="submit" class="btn btn-sm btn-dark w-100 text-truncate text-start p-2 border border-secondary border-opacity-25" style="border-radius: 8px; font-size: 0.75rem;">
                            <div class="fw-bold text-white"><i class="bi bi-person text-info me-1"></i> Sales Exec</div>
                            <div class="text-white-50" style="font-size: 0.68rem;">Assigned View</div>
                        </button>
                    </form>
                </div>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
