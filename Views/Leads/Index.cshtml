@model AcxiomCRM.ViewModels.LeadListViewModel
@{
    ViewData["Title"] = "Lead Management";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <h2 class="fw-bold text-dark mb-1 tracking-tight">Leads & Prospects</h2>
        <p class="text-muted small mb-0">Capture, qualify, and convert inbound sales leads into enterprise revenue.</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <a asp-action="Create" class="btn btn-primary-crm shadow-sm">
            <i class="bi bi-funnel-fill"></i>
            <span>Capture New Lead</span>
        </a>
    </div>
</div>

<!-- Status Tabs Bar -->
<div class="d-flex gap-2 overflow-auto pb-2 mb-3">
    <a asp-action="Index" asp-route-statusFilter="all" 
       class="btn btn-sm @(string.IsNullOrEmpty(Model.StatusFilter) || Model.StatusFilter == "all" ? "btn-dark" : "btn-light border") px-3 rounded-pill fw-semibold">
        All Leads <span class="badge bg-secondary ms-1">@Model.TotalCount</span>
    </a>
    <a asp-action="Index" asp-route-statusFilter="New" 
       class="btn btn-sm @(Model.StatusFilter == "New" ? "btn-primary" : "btn-light border") px-3 rounded-pill fw-semibold">
        New <span class="badge bg-primary ms-1">@Model.NewCount</span>
    </a>
    <a asp-action="Index" asp-route-statusFilter="Contacted" 
       class="btn btn-sm @(Model.StatusFilter == "Contacted" ? "btn-info text-white" : "btn-light border") px-3 rounded-pill fw-semibold">
        Contacted <span class="badge bg-info text-white ms-1">@Model.ContactedCount</span>
    </a>
    <a asp-action="Index" asp-route-statusFilter="Qualified" 
       class="btn btn-sm @(Model.StatusFilter == "Qualified" ? "btn-success" : "btn-light border") px-3 rounded-pill fw-semibold">
        Qualified <span class="badge bg-success ms-1">@Model.QualifiedCount</span>
    </a>
    <a asp-action="Index" asp-route-statusFilter="Converted" 
       class="btn btn-sm @(Model.StatusFilter == "Converted" ? "btn-indigo text-white bg-indigo" : "btn-light border") px-3 rounded-pill fw-semibold" style="@(Model.StatusFilter == "Converted" ? "background-color: #4f46e5 !important;" : "")">
        Converted <span class="badge bg-light text-dark ms-1">@Model.ConvertedCount</span>
    </a>
    <a asp-action="Index" asp-route-statusFilter="Lost" 
       class="btn btn-sm @(Model.StatusFilter == "Lost" ? "btn-danger" : "btn-light border") px-3 rounded-pill fw-semibold">
        Lost <span class="badge bg-danger ms-1">@Model.LostCount</span>
    </a>
</div>

<!-- Search & Filter Bar -->
<div class="crm-card mb-4">
    <div class="p-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-center">
            <input type="hidden" name="statusFilter" value="@Model.StatusFilter" />

            <div class="col-md-5">
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-search"></i></span>
                    <input type="text" name="searchTerm" value="@Model.SearchTerm" class="form-control border-start-0 shadow-none" 
                           placeholder="Search by lead name, company, email, phone or code..." />
                </div>
            </div>
            <div class="col-md-3">
                <select name="priorityFilter" class="form-select shadow-none">
                    <option value="">All Priorities</option>
                    <option value="High" selected="@(Model.PriorityFilter == "High")">High Priority</option>
                    <option value="Medium" selected="@(Model.PriorityFilter == "Medium")">Medium Priority</option>
                    <option value="Low" selected="@(Model.PriorityFilter == "Low")">Low Priority</option>
                </select>
            </div>
            <div class="col-md-2">
                <select name="sourceFilter" class="form-select shadow-none">
                    <option value="">All Sources</option>
                    <option value="Website" selected="@(Model.SourceFilter == "Website")">Website</option>
                    <option value="Referral" selected="@(Model.SourceFilter == "Referral")">Referral</option>
                    <option value="Trade Show" selected="@(Model.SourceFilter == "Trade Show")">Trade Show</option>
                    <option value="Partner" selected="@(Model.SourceFilter == "Partner")">Partner</option>
                    <option value="Social Media" selected="@(Model.SourceFilter == "Social Media")">Social Media</option>
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary-crm w-100 justify-content-center">Filter</button>
            </div>
        </form>
    </div>

    <!-- Leads Table -->
    <div class="table-responsive">
        <table class="table crm-table align-middle">
            <thead>
                <tr>
                    <th>Lead Code</th>
                    <th>Lead Name</th>
                    <th>Company</th>
                    <th>Source</th>
                    <th>Status</th>
                    <th>Priority</th>
                    <th>Est. Value</th>
                    <th>Owner</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Leads.Any())
                {
                    @foreach (var l in Model.Leads)
                    {
                        <tr>
                            <td>
                                <span class="badge bg-light text-primary border fw-semibold">@l.LeadCode</span>
                            </td>
                            <td>
                                <a asp-action="Details" asp-route-id="@l.LeadId" class="fw-bold text-dark text-decoration-none hover-primary">
                                    @l.LeadName
                                </a>
                                <div class="small text-muted"><i class="bi bi-envelope me-1"></i>@l.Email</div>
                            </td>
                            <td>
                                <span class="text-secondary fw-medium">@(l.CompanyName ?? "Individual")</span>
                            </td>
                            <td>
                                <span class="badge bg-light text-secondary border">@l.Source</span>
                            </td>
                            <td>
                                <span class="badge-crm @(l.Status == "Qualified" ? "badge-qualified" : l.Status == "Converted" ? "badge-converted" : l.Status == "Lost" ? "badge-lost" : l.Status == "Contacted" ? "badge-contacted" : "badge-new")">
                                    @l.Status
                                </span>
                            </td>
                            <td>
                                <span class="badge-crm @(l.Priority == "High" ? "badge-high" : l.Priority == "Medium" ? "badge-medium" : "badge-low")">
                                    @l.Priority
                                </span>
                            </td>
                            <td>
                                <div class="fw-bold text-dark">$@l.ExpectedValue.ToString("N0")</div>
                            </td>
                            <td>
                                <span class="small text-dark fw-medium">@l.AssignedToName</span>
                            </td>
                            <td class="text-end">
                                <div class="btn-group">
                                    @if (l.Status != "Converted")
                                    {
                                        <a asp-action="Convert" asp-route-id="@l.LeadId" class="btn btn-sm btn-outline-success fw-semibold" title="Convert to Customer & Deal">
                                            <i class="bi bi-arrow-repeat"></i> Convert
                                        </a>
                                    }
                                    <a asp-action="Details" asp-route-id="@l.LeadId" class="btn btn-sm btn-light border" title="View Lead">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@l.LeadId" class="btn btn-sm btn-light border" title="Edit Lead">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <button type="button" class="btn btn-sm btn-light border text-danger" 
                                            data-bs-toggle="modal" data-bs-target="#deleteConfirmModal"
                                            data-action="@Url.Action("Delete", "Leads", new { id = l.LeadId })"
                                            data-name="@l.LeadName" data-type="Lead Record"
                                            title="Delete Lead">
                                        <i class="bi bi-trash3"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="9" class="text-center py-5 text-muted">
                            <i class="bi bi-funnel fs-1 d-block mb-2 text-secondary"></i>
                            <h5>No Leads Found</h5>
                            <p class="small text-muted mb-3">No prospect records match your filter criteria.</p>
                            <a asp-action="Create" class="btn btn-sm btn-primary-crm">Capture New Lead</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <div class="p-3 border-top d-flex justify-content-between align-items-center">
            <span class="text-muted small">Showing @Model.Leads.Count of @Model.TotalItems records</span>
            <nav aria-label="Page navigation">
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage - 1)" 
                           asp-route-searchTerm="@Model.SearchTerm" asp-route-statusFilter="@Model.StatusFilter">Previous</a>
                    </li>
                    @for (int p = 1; p <= Model.TotalPages; p++)
                    {
                        <li class="page-item @(p == Model.CurrentPage ? "active" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@p"
                               asp-route-searchTerm="@Model.SearchTerm" asp-route-statusFilter="@Model.StatusFilter">@p</a>
                        </li>
                    }
                    <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage + 1)"
                           asp-route-searchTerm="@Model.SearchTerm" asp-route-statusFilter="@Model.StatusFilter">Next</a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>
