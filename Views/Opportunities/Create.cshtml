@model AcxiomCRM.ViewModels.OpportunityFormViewModel
@{
    ViewData["Title"] = "Create Opportunity Deal";
}

<div class="row justify-content-center">
    <div class="col-lg-9">
        <div class="d-flex align-items-center justify-content-between mb-4">
            <div>
                <a asp-action="Index" class="text-decoration-none text-muted small d-inline-flex align-items-center gap-1 mb-1">
                    <i class="bi bi-arrow-left"></i> Back to Opportunities
                </a>
                <h2 class="fw-bold text-dark mb-0">Create Sales Deal</h2>
            </div>
        </div>

        <div class="crm-card">
            <div class="crm-card-header">
                <div>
                    <h5 class="crm-card-title">Deal Parameters & Terms</h5>
                    <small class="text-muted">Enter pipeline valuation, probability, and target closing date</small>
                </div>
                <span class="badge bg-light text-muted border">New Deal</span>
            </div>

            <div class="crm-card-body">
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger py-2 px-3 small border-0 mb-4" style="background-color: #fef2f2; color: #991b1b; border-radius: 8px;">
                        <div asp-validation-summary="All" class="mb-0"></div>
                    </div>
                }

                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()

                    <div class="row g-3">
                        <!-- Opportunity Name -->
                        <div class="col-12">
                            <label asp-for="OpportunityName" class="form-label-crm"></label>
                            <input asp-for="OpportunityName" class="form-control form-control-crm" placeholder="e.g. Enterprise Cloud Migration" />
                            <span asp-validation-for="OpportunityName" class="text-danger small"></span>
                        </div>

                        <!-- Associated Customer -->
                        <div class="col-md-6">
                            <label asp-for="CustomerId" class="form-label-crm"></label>
                            <select asp-for="CustomerId" class="form-select form-select-crm" asp-items="ViewBag.CustomersList">
                                <option value="">Select Associated Customer...</option>
                            </select>
                            <span asp-validation-for="CustomerId" class="text-danger small"></span>
                        </div>

                        <!-- Source -->
                        <div class="col-md-6">
                            <label asp-for="Source" class="form-label-crm"></label>
                            <input asp-for="Source" class="form-control form-control-crm" placeholder="e.g. Inbound Website / RFP" />
                            <span asp-validation-for="Source" class="text-danger small"></span>
                        </div>

                        <!-- Deal Amount -->
                        <div class="col-md-6">
                            <label asp-for="Amount" class="form-label-crm"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-white border-end-0 text-muted">$</span>
                                <input asp-for="Amount" class="form-control form-control-crm border-start-0" type="number" step="500" min="1" />
                            </div>
                            <small class="text-muted" style="font-size: 0.72rem;">Requirement: Deal Amount must be greater than 0.</small>
                            <span asp-validation-for="Amount" class="text-danger small d-block"></span>
                        </div>

                        <!-- Win Probability -->
                        <div class="col-md-6">
                            <label asp-for="Probability" class="form-label-crm"></label>
                            <div class="input-group">
                                <input asp-for="Probability" class="form-control form-control-crm border-end-0" type="number" min="0" max="100" />
                                <span class="input-group-text bg-white border-start-0 text-muted">%</span>
                            </div>
                            <small class="text-muted" style="font-size: 0.72rem;">Requirement: Probability between 0 and 100.</small>
                            <span asp-validation-for="Probability" class="text-danger small d-block"></span>
                        </div>

                        <!-- Pipeline Stage -->
                        <div class="col-md-6">
                            <label asp-for="Stage" class="form-label-crm"></label>
                            <select asp-for="Stage" class="form-select form-select-crm" id="stageSelect">
                                <option value="Qualification">Qualification (20%)</option>
                                <option value="Proposal">Proposal (50%)</option>
                                <option value="Negotiation">Negotiation (80%)</option>
                                <option value="Won">Won (100%)</option>
                                <option value="Lost">Lost (0%)</option>
                            </select>
                            <span asp-validation-for="Stage" class="text-danger small"></span>
                        </div>

                        <!-- Expected Close Date -->
                        <div class="col-md-6">
                            <label asp-for="ExpectedCloseDate" class="form-label-crm"></label>
                            <input asp-for="ExpectedCloseDate" class="form-control form-control-crm" type="date" />
                            <small class="text-muted" style="font-size: 0.72rem;">Requirement: Cannot be in the past for active opportunities.</small>
                            <span asp-validation-for="ExpectedCloseDate" class="text-danger small d-block"></span>
                        </div>

                        <!-- Opportunity Owner -->
                        <div class="col-12">
                            <label asp-for="AssignedTo" class="form-label-crm"></label>
                            <select asp-for="AssignedTo" class="form-select form-select-crm" asp-items="ViewBag.UsersList">
                                <option value="">Select Opportunity Owner...</option>
                            </select>
                            <span asp-validation-for="AssignedTo" class="text-danger small"></span>
                        </div>

                        <!-- Notes & Strategy -->
                        <div class="col-12">
                            <label asp-for="Notes" class="form-label-crm"></label>
                            <textarea asp-for="Notes" class="form-control form-control-crm" rows="3" placeholder="Commercial terms, competitor landscape, procurement milestones..."></textarea>
                            <span asp-validation-for="Notes" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mt-4 pt-3 border-top d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-secondary-crm">Cancel</a>
                        <button type="submit" class="btn btn-primary-crm">
                            <i class="bi bi-check2-circle"></i> Save Deal to Pipeline
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.getElementById('stageSelect')?.addEventListener('change', function () {
            const probInput = document.querySelector('input[name="Probability"]');
            if (!probInput) return;
            switch(this.value) {
                case 'Qualification': probInput.value = 20; break;
                case 'Proposal': probInput.value = 50; break;
                case 'Negotiation': probInput.value = 80; break;
                case 'Won': probInput.value = 100; break;
                case 'Lost': probInput.value = 0; break;
            }
        });
    </script>
}
