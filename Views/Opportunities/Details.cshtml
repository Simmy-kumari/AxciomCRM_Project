@model AcxiomCRM.ViewModels.OpportunityDetailsViewModel
@{
    var opp = Model.Opportunity;
    ViewData["Title"] = $"{opp.OpportunityName} — Opportunity Deal";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
    <div>
        <a asp-action="Index" class="text-decoration-none text-muted small d-inline-flex align-items-center gap-1 mb-1">
            <i class="bi bi-arrow-left"></i> Back to Opportunities
        </a>
        <div class="d-flex align-items-center gap-3">
            <h2 class="fw-bold text-dark mb-0">@opp.OpportunityName</h2>
            <span class="badge-crm @(opp.Stage == "Won" ? "badge-won" : opp.Stage == "Lost" ? "badge-lost" : opp.Stage == "Negotiation" ? "badge-negotiation" : opp.Stage == "Proposal" ? "badge-proposal" : "badge-new")">
                @opp.Stage
            </span>
        </div>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@opp.OpportunityId" class="btn btn-secondary-crm">
            <i class="bi bi-pencil"></i> Edit Deal
        </a>
        <a asp-controller="FollowUps" asp-action="Create" asp-route-relatedType="Opportunity" asp-route-relatedId="@opp.OpportunityId" class="btn btn-primary-crm">
            <i class="bi bi-calendar-plus"></i> Schedule Follow-Up
        </a>
    </div>
</div>

<!-- Deal Highlight Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="card border-0 shadow-sm p-3 bg-white" style="border-radius: var(--crm-radius);">
            <div class="text-muted small fw-bold text-uppercase mb-1">Contract Valuation</div>
            <div class="fs-4 fw-bold text-primary">$@opp.Amount.ToString("N0")</div>
            <small class="text-muted">Direct Contract Value</small>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card border-0 shadow-sm p-3 bg-white" style="border-radius: var(--crm-radius);">
            <div class="text-muted small fw-bold text-uppercase mb-1">Win Probability</div>
            <div class="fs-4 fw-bold text-dark">@opp.Probability%</div>
            <div class="progress mt-1" style="height: 4px;">
                <div class="progress-bar @(opp.Probability >= 70 ? "bg-success" : opp.Probability >= 40 ? "bg-primary" : "bg-warning")" 
                     style="width: @opp.Probability%"></div>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card border-0 shadow-sm p-3 bg-white" style="border-radius: var(--crm-radius);">
            <div class="text-muted small fw-bold text-uppercase mb-1">Weighted Forecast</div>
            <div class="fs-4 fw-bold text-success">$@opp.WeightedAmount.ToString("N0")</div>
            <small class="text-muted">Amount &times; Prob / 100</small>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card border-0 shadow-sm p-3 bg-white" style="border-radius: var(--crm-radius);">
            <div class="text-muted small fw-bold text-uppercase mb-1">Target Close Date</div>
            <div class="fs-5 fw-bold text-dark">@opp.ExpectedCloseDate.ToString("MMM dd, yyyy")</div>
            <small class="text-muted">Owner: @Model.OwnerName</small>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <!-- Account Information -->
    <div class="col-lg-6">
        <div class="crm-card h-100">
            <div class="crm-card-header">
                <h6 class="crm-card-title">Associated Client Account</h6>
            </div>
            <div class="crm-card-body">
                @if (opp.Customer != null)
                {
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <div class="user-avatar-sm" style="width: 44px; height: 44px; font-size: 1rem;">
                            @(opp.Customer.CustomerName.Substring(0, 1))
                        </div>
                        <div>
                            <a asp-controller="Customers" asp-action="Details" asp-route-id="@opp.Customer.CustomerId" class="fw-bold text-dark text-decoration-none fs-6 hover-primary">
                                @opp.Customer.CustomerName
                            </a>
                            <div class="text-muted small">@(opp.Customer.CompanyName ?? "Enterprise Account") &bull; @opp.Customer.CustomerCode</div>
                        </div>
                    </div>
                    <div class="small text-secondary mb-1"><i class="bi bi-envelope me-2"></i>@opp.Customer.Email</div>
                    <div class="small text-secondary"><i class="bi bi-telephone me-2"></i>@opp.Customer.Phone</div>
                }
                else
                {
                    <div class="text-muted small">No direct customer linked. Generated as prospective deal.</div>
                }
            </div>
        </div>
    </div>

    <!-- Deal Notes -->
    <div class="col-lg-6">
        <div class="crm-card h-100">
            <div class="crm-card-header">
                <h6 class="crm-card-title">Strategy & Milestone Notes</h6>
            </div>
            <div class="crm-card-body">
                <p class="text-secondary small mb-0">
                    @(string.IsNullOrWhiteSpace(opp.Notes) ? "No notes recorded for this opportunity." : opp.Notes)
                </p>
            </div>
        </div>
    </div>

    <!-- Follow-Ups List -->
    <div class="col-12">
        <div class="crm-card">
            <div class="crm-card-header">
                <h6 class="crm-card-title">Deal Follow-Ups & Reviews</h6>
                <a asp-controller="FollowUps" asp-action="Create" asp-route-relatedType="Opportunity" asp-route-relatedId="@opp.OpportunityId" class="btn btn-sm btn-outline-primary">
                    <i class="bi bi-plus"></i> Schedule Follow-Up
                </a>
            </div>
            <div class="crm-card-body p-0">
                @if (Model.FollowUps.Any())
                {
                    <div class="list-group list-group-flush">
                        @foreach (var fu in Model.FollowUps)
                        {
                            <div class="list-group-item p-3 d-flex justify-content-between align-items-center">
                                <div>
                                    <div class="fw-bold text-dark">@fu.Subject</div>
                                    <small class="text-muted">@fu.FollowUpDate.ToString("MMM dd, yyyy - hh:mm tt") &bull; @fu.FollowUpType</small>
                                </div>
                                <span class="badge-crm @(fu.Status == "Completed" ? "badge-won" : "badge-new")">@fu.Status</span>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="p-4 text-center text-muted small">No follow-ups recorded for this deal.</div>
                }
            </div>
        </div>
    </div>
</div>
