@model AcxiomCRM.ViewModels.OpportunityItemDto

<div class="kanban-card">
    <div class="d-flex justify-content-between align-items-start mb-1">
        <a asp-action="Details" asp-route-id="@Model.OpportunityId" class="kanban-card-title text-decoration-none text-dark hover-primary">
            @Model.OpportunityName
        </a>
        <div class="dropdown">
            <button class="btn btn-sm btn-link text-muted p-0" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="Move Stage">
                <i class="bi bi-three-dots-vertical"></i>
            </button>
            <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 py-1" style="font-size: 0.8rem;">
                <li class="dropdown-header text-uppercase" style="font-size: 0.68rem;">Move to Stage:</li>
                @foreach (var stg in new[] { "Qualification", "Proposal", "Negotiation", "Won", "Lost" })
                {
                    if (stg != Model.Stage)
                    {
                        <li>
                            <form asp-action="UpdateStage" asp-route-id="@Model.OpportunityId" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="stage" value="@stg" />
                                <button type="submit" class="dropdown-item py-1">@stg</button>
                            </form>
                        </li>
                    }
                }
                <li><hr class="dropdown-divider my-1"></li>
                <li><a class="dropdown-item py-1" asp-action="Edit" asp-route-id="@Model.OpportunityId"><i class="bi bi-pencil me-1"></i> Edit</a></li>
            </ul>
        </div>
    </div>

    <div class="kanban-card-company">
        <i class="bi bi-building me-1"></i> @(Model.CompanyName ?? Model.CustomerName ?? "Prospective Deal")
    </div>

    <div class="d-flex justify-content-between align-items-center mb-2">
        <span class="kanban-card-amount">$@Model.Amount.ToString("N0")</span>
        <span class="badge bg-light text-secondary border" style="font-size: 0.72rem;">@Model.Probability% Win</span>
    </div>

    <div class="progress mb-2" style="height: 4px;">
        <div class="progress-bar @(Model.Probability >= 70 ? "bg-success" : Model.Probability >= 40 ? "bg-primary" : "bg-warning")" 
             style="width: @Model.Probability%"></div>
    </div>

    <div class="d-flex justify-content-between align-items-center small text-muted" style="font-size: 0.75rem;">
        <span><i class="bi bi-calendar3 me-1"></i> @Model.ExpectedCloseDate.ToString("MMM dd")</span>
        <span><i class="bi bi-person me-1"></i> @(Model.OwnerName ?? "Unassigned")</span>
    </div>
</div>
