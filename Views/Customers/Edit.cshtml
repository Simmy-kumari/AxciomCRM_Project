@model AcxiomCRM.ViewModels.CustomerFormViewModel
@{
    ViewData["Title"] = $"Edit Customer — {Model.CustomerName}";
}

<div class="row justify-content-center">
    <div class="col-lg-9">
        <div class="d-flex align-items-center justify-content-between mb-4">
            <div>
                <a asp-action="Index" class="text-decoration-none text-muted small d-inline-flex align-items-center gap-1 mb-1">
                    <i class="bi bi-arrow-left"></i> Back to Customers
                </a>
                <h2 class="fw-bold text-dark mb-0">Edit Customer: @Model.CustomerName</h2>
            </div>
            <span class="badge bg-light text-primary border fs-6 px-3 py-2">@Model.CustomerCode</span>
        </div>

        <div class="crm-card">
            <div class="crm-card-header">
                <div>
                    <h5 class="crm-card-title">Modify Customer Details</h5>
                    <small class="text-muted">Update master contact and account fields</small>
                </div>
            </div>

            <div class="crm-card-body">
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger py-2 px-3 small border-0 mb-4" style="background-color: #fef2f2; color: #991b1b; border-radius: 8px;">
                        <div asp-validation-summary="All" class="mb-0"></div>
                    </div>
                }

                <form asp-action="Edit" asp-route-id="@Model.CustomerId" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="CustomerId" />
                    <input type="hidden" asp-for="CustomerCode" />

                    <div class="row g-3">
                        <!-- Customer Name -->
                        <div class="col-md-6">
                            <label asp-for="CustomerName" class="form-label-crm"></label>
                            <input asp-for="CustomerName" class="form-control form-control-crm" />
                            <span asp-validation-for="CustomerName" class="text-danger small"></span>
                        </div>

                        <!-- Company Name -->
                        <div class="col-md-6">
                            <label asp-for="CompanyName" class="form-label-crm"></label>
                            <input asp-for="CompanyName" class="form-control form-control-crm" />
                            <span asp-validation-for="CompanyName" class="text-danger small"></span>
                        </div>

                        <!-- Email -->
                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label-crm"></label>
                            <input asp-for="Email" class="form-control form-control-crm" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <!-- Phone -->
                        <div class="col-md-6">
                            <label asp-for="Phone" class="form-label-crm"></label>
                            <input asp-for="Phone" class="form-control form-control-crm" />
                            <span asp-validation-for="Phone" class="text-danger small"></span>
                        </div>

                        <!-- Address -->
                        <div class="col-12">
                            <label asp-for="Address" class="form-label-crm"></label>
                            <input asp-for="Address" class="form-control form-control-crm" />
                            <span asp-validation-for="Address" class="text-danger small"></span>
                        </div>

                        <!-- City & State -->
                        <div class="col-md-6">
                            <label asp-for="City" class="form-label-crm"></label>
                            <input asp-for="City" class="form-control form-control-crm" />
                            <span asp-validation-for="City" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="State" class="form-label-crm"></label>
                            <input asp-for="State" class="form-control form-control-crm" />
                            <span asp-validation-for="State" class="text-danger small"></span>
                        </div>

                        <!-- Status & Assigned User -->
                        <div class="col-md-6">
                            <label asp-for="Status" class="form-label-crm"></label>
                            <select asp-for="Status" class="form-select form-select-crm">
                                <option value="Active">Active</option>
                                <option value="Inactive">Inactive</option>
                            </select>
                            <span asp-validation-for="Status" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="OwnerId" class="form-label-crm"></label>
                            <select asp-for="OwnerId" class="form-select form-select-crm" asp-items="ViewBag.UsersList">
                                <option value="">Select Sales Executive...</option>
                            </select>
                            <span asp-validation-for="OwnerId" class="text-danger small"></span>
                        </div>

                        <!-- Notes -->
                        <div class="col-12">
                            <label asp-for="Notes" class="form-label-crm"></label>
                            <textarea asp-for="Notes" class="form-control form-control-crm" rows="3"></textarea>
                            <span asp-validation-for="Notes" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mt-4 pt-3 border-top d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-secondary-crm">Cancel</a>
                        <button type="submit" class="btn btn-primary-crm">
                            <i class="bi bi-check2-circle"></i> Save Changes
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
