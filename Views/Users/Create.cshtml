@model AcxiomCRM.ViewModels.UserCreateViewModel
@{
    ViewData["Title"] = "Register User & Assign Role";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="d-flex align-items-center justify-content-between mb-4">
            <div>
                <a asp-action="Index" class="text-decoration-none text-muted small d-inline-flex align-items-center gap-1 mb-1">
                    <i class="bi bi-arrow-left"></i> Back to Users
                </a>
                <h2 class="fw-bold text-dark mb-0">Register New System User</h2>
            </div>
        </div>

        <div class="crm-card">
            <div class="crm-card-header">
                <div>
                    <h5 class="crm-card-title">User Account Details</h5>
                    <small class="text-muted">Create Identity credentials and assign security role</small>
                </div>
            </div>

            <div class="crm-card-body">
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger py-2 px-3 small border-0 mb-4" style="background-color: #fef2f2; color: #991b1b; border-radius: 8px;">
                        <div asp-validation-summary="All" class="mb-0"></div>
                    </div>
                }

                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="FullName" class="form-label-crm"></label>
                            <input asp-for="FullName" class="form-control form-control-crm" placeholder="e.g. Sarah Jenkins" />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label-crm"></label>
                            <input asp-for="Email" class="form-control form-control-crm" placeholder="sarah@acxiom.com" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Department" class="form-label-crm"></label>
                            <input asp-for="Department" class="form-control form-control-crm" placeholder="e.g. Enterprise Sales" />
                            <span asp-validation-for="Department" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Role" class="form-label-crm"></label>
                            <select asp-for="Role" class="form-select form-select-crm" asp-items="ViewBag.RolesList">
                            </select>
                            <span asp-validation-for="Role" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Password" class="form-label-crm"></label>
                            <input asp-for="Password" type="password" class="form-control form-control-crm" placeholder="Enter complex password (e.g. User@123!)" />
                            <small class="text-muted" style="font-size: 0.72rem;">Password must contain at least 8 characters, with uppercase, lowercase, digit, and special character.</small>
                            <span asp-validation-for="Password" class="text-danger small d-block"></span>
                        </div>
                    </div>

                    <div class="mt-4 pt-3 border-top d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-secondary-crm">Cancel</a>
                        <button type="submit" class="btn btn-primary-crm">
                            <i class="bi bi-person-check-fill"></i> Create User
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
