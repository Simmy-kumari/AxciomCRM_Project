@model AcxiomCRM.ViewModels.UserEditViewModel
@{
    ViewData["Title"] = $"Edit User — {Model.FullName}";
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="d-flex align-items-center justify-content-between mb-4">
            <div>
                <a asp-action="Index" class="text-decoration-none text-muted small d-inline-flex align-items-center gap-1 mb-1">
                    <i class="bi bi-arrow-left"></i> Back to Users
                </a>
                <h2 class="fw-bold text-dark mb-0">Edit User: @Model.FullName</h2>
            </div>
        </div>

        <div class="crm-card">
            <div class="crm-card-header">
                <div>
                    <h5 class="crm-card-title">Modify User Account</h5>
                    <small class="text-muted">Update roles, department, and account permissions</small>
                </div>
            </div>

            <div class="crm-card-body">
                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger py-2 px-3 small border-0 mb-4" style="background-color: #fef2f2; color: #991b1b; border-radius: 8px;">
                        <div asp-validation-summary="All" class="mb-0"></div>
                    </div>
                }

                <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label asp-for="FullName" class="form-label-crm"></label>
                            <input asp-for="FullName" class="form-control form-control-crm" />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label-crm"></label>
                            <input asp-for="Email" class="form-control form-control-crm" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Department" class="form-label-crm"></label>
                            <input asp-for="Department" class="form-control form-control-crm" />
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Role" class="form-label-crm"></label>
                            <select asp-for="Role" class="form-select form-select-crm" asp-items="ViewBag.RolesList">
                            </select>
                            <span asp-validation-for="Role" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <div class="form-check form-switch mt-2">
                                <input asp-for="IsActive" class="form-check-input" type="checkbox" id="userActiveCheck" />
                                <label class="form-check-label fw-bold text-dark" for="userActiveCheck">Account Active</label>
                            </div>
                            <small class="text-muted">Deactivating prevents this user from logging into AcxiomCRM.</small>
                        </div>

                        <div class="col-12">
                            <hr class="my-2" />
                            <label asp-for="NewPassword" class="form-label-crm"></label>
                            <input asp-for="NewPassword" type="password" class="form-control form-control-crm" placeholder="Leave empty if password remains unchanged" />
                            <small class="text-muted" style="font-size: 0.72rem;">If providing a new password, it must meet complexity standards.</small>
                        </div>
                    </div>

                    <div class="mt-4 pt-3 border-top d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-secondary-crm">Cancel</a>
                        <button type="submit" class="btn btn-primary-crm">
                            <i class="bi bi-check2-circle"></i> Save Profile
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
